    "@yeger/vue-masonry-wall": "^6.1.1",
    "dom-to-image-more": "^3.7.2",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lz-string": "^1.5.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "vuetify": "^4.0.6"
  },
  "devDependencies": {
